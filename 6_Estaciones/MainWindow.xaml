<Window x:Class="_6_Estaciones.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_6_Estaciones"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel Background="MediumAquamarine">
        <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center"
                   FontFamily="JetBrains Mono" FontSize="24">
            Las 4 estaciones
            <TextBlock.Foreground>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Aqua" Offset="0"/>
                    <GradientStop Color="DarkBlue" Offset="1"></GradientStop>
                </LinearGradientBrush>
            </TextBlock.Foreground>
            <TextBlock.Effect>
                <DropShadowEffect
                    ShadowDepth="4"
                    Direction="330"
                    Color="DarkBlue"
                    Opacity="0.5"
                    BlurRadius="4"/>
            </TextBlock.Effect>
        </TextBlock>
        <UniformGrid Columns="2" Rows="2">
            <ScrollViewer Margin="10" HorizontalScrollBarVisibility="Auto">
                <Image Source="Assets/invierno.jpg" Stretch="None"/>
            </ScrollViewer>
            <ScrollViewer Margin="10" HorizontalScrollBarVisibility="Auto">
                <Image Source="Assets/primavera.jpg" Stretch="None"/>
            </ScrollViewer>            
            <ScrollViewer Margin="10" HorizontalScrollBarVisibility="Auto">
                <Image Source="Assets/verano.jpg" Stretch="None"/>
            </ScrollViewer>
            <ScrollViewer Margin="10" HorizontalScrollBarVisibility="Auto">
                <Image Source="Assets/otoño.jpg" Stretch="None"/>
            </ScrollViewer>
        </UniformGrid>
    </DockPanel>
</Window>
