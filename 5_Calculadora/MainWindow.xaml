<Window x:Class="_5_Calculadora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_5_Calculadora"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="250">
    <Viewbox>
        <Grid RowDefinitions="1*,2*,Auto">
            <TextBox Margin="1" Grid.Row="0">
                1234567890
            </TextBox>
            <Grid Grid.Row="1" HorizontalAlignment="Stretch" ColumnDefinitions="1*,1*,1*" RowDefinitions="1*,1*,1*">
                <Button Margin="1" Grid.Row="0" Grid.Column="0">1</Button>
                <Button Margin="1" Grid.Row="0" Grid.Column="1">2</Button>
                <Button Margin="1" Grid.Row="0" Grid.Column="2">3</Button>
                <Button Margin="1" Grid.Row="1" Grid.Column="0">4</Button>
                <Button Margin="1" Grid.Row="1" Grid.Column="1">5</Button>
                <Button Margin="1" Grid.Row="1" Grid.Column="2">6</Button>
                <Button Margin="1" Grid.Row="2" Grid.Column="0">7</Button>
                <Button Margin="1" Grid.Row="2" Grid.Column="1">8</Button>
                <Button Margin="1" Grid.Row="2" Grid.Column="2">9</Button>
            </Grid>
            <Button Margin="1" Grid.Row="2">0</Button>
        </Grid>
    </Viewbox>
</Window>
