<Window x:Class="_3_Mosaico.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3_Mosaico"
        mc:Ignorable="d"
        Title="MainWindow" Height="300" Width="300">
    <DockPanel>
        <DockPanel Background="Black" LastChildFill="True">
            <Label DockPanel.Dock="Top" Background="MediumPurple" Height="50"/>
            <Label DockPanel.Dock="Left" Background="MediumPurple" Width="50"/>
            <Label DockPanel.Dock="Right" Background="Green" Width="50"/>
            <Label DockPanel.Dock="Bottom" Background="Green" Height="50"/>


            <DockPanel Background="Black" LastChildFill="False">
                <Label DockPanel.Dock="Left" Background="Orange" Width="50"/>
                <Label DockPanel.Dock="Bottom" Background="Orange" Height="50"/>
                <Label DockPanel.Dock="Top" Background="DeepPink" Height="50"/>
                <Label DockPanel.Dock="Right" Background="DeepPink" Width="50"/>
            </DockPanel>
        </DockPanel>
    </DockPanel>
</Window>
